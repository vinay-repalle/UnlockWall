{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)"
    ]
  },
  "env": {
    "ANDROID_HOME": "/home/vinayrepalle/Documents/UnlockWall/.tools/android-sdk",
    "ANDROID_SDK_ROOT": "/home/vinayrepalle/Documents/UnlockWall/.tools/android-sdk",
    "ANDROID_USER_HOME": "/home/vinayrepalle/Documents/UnlockWall/.tools/android-user",
    "GRADLE_USER_HOME": "/home/vinayrepalle/Documents/UnlockWall/.tools/gradle"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.py\""
          }
        ]
      }
    ]
  }
}
